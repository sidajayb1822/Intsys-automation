// --- Marketing Functions ---
function toggleNextStep(obj) {
    const sheet = SpreadsheetApp.openById(SPREADSHEET_ID).getSheetByName('Interactions');
    const data = sheet.getDataRange().getValues();

    const matchesText = (row) => {
        const sheetDate = row[6];
        let matchDate = false;
        if (sheetDate instanceof Date) {
            const y = sheetDate.getFullYear();
            const m = String(sheetDate.getMonth() + 1).padStart(2, '0');
            const d = String(sheetDate.getDate()).padStart(2, '0');
            // Fallback: Check UTC date to prevent timezone shifts from breaking the match
            const utcIso = sheetDate.toISOString().split('T')[0];
            matchDate = (`${y}-${m}-${d}` === obj.nextActionDate) || (utcIso === obj.nextActionDate);
        } else if (typeof sheetDate === 'string') {
            matchDate = sheetDate.includes(obj.nextActionDate);
        }
        return matchDate &&
            String(row[1]).trim() === String(obj.companyId).trim() &&
            String(row[5]).trim() === String(obj.nextAction).trim() &&
            String(row[7]).trim() !== 'Completed' &&
            String(row[7]).trim() !== 'Completed Late';
    };

    // 1st choice: exact InteractionID. Fallback: company + action + date on a still-open task
    let rowIdx = -1;
    if (obj.interactionId) {
        rowIdx = data.findIndex((row, idx) => idx > 0 && String(row[8]).trim() === String(obj.interactionId).trim());
    }
    if (rowIdx < 1) {
        rowIdx = data.findIndex((row, idx) => idx > 0 && matchesText(row));
    }

    if (rowIdx < 1) return false;

    const i = rowIdx;
    const sheetDate = data[i][6];
    let status = 'Completed';
    let dueDate = sheetDate instanceof Date ? new Date(sheetDate) : new Date(obj.nextActionDate);
    let today = new Date(); today.setHours(0, 0, 0, 0); dueDate.setHours(0, 0, 0, 0);
    // A reason is only sent when the frontend judged the task late, so trust it even if the script timezone disagrees
    if (today > dueDate || obj.reason) status = 'Completed Late';
    sheet.getRange(i + 1, 8).setValue(status);

    // If a late reason was provided, append it to the description
    if (obj.reason) {
        const currentDesc = data[i][3] || '';
        const newDesc = currentDesc + ` [Task '${obj.nextAction}' completed late. Reason: ${obj.reason}]`;
        sheet.getRange(i + 1, 4).setValue(newDesc);
    }

    return true;
}

