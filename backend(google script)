    return true;
}

// --- DIAGNOSTIC: Check MoM Schema ---
function checkMoMSchema() {
    const ss = SpreadsheetApp.openById(SPREADSHEET_ID);
    const sheet = ss.getSheetByName('MoMs');

    if (!sheet) {
        Logger.log('❌ MoMs sheet does not exist.');
        return;
    }

    const lastColumn = sheet.getLastColumn();
    const currentHeaders = sheet.getRange(1, 1, 1, lastColumn).getValues()[0];
    const expectedHeaders = ['ID', 'Date', 'Title', 'Attendees', 'Notes', 'ActionItemsJSON', 'CreatedBy'];

    Logger.log('=== MoM SCHEMA DIAGNOSTIC ===');
    Logger.log('Expected headers: ' + expectedHeaders.join(' | '));
    Logger.log('Current headers:  ' + currentHeaders.join(' | '));
    Logger.log('Expected columns: ' + expectedHeaders.length);
    Logger.log('Current columns:  ' + lastColumn);
    Logger.log('');

    // Detailed comparison
    for (let i = 0; i < Math.max(expectedHeaders.length, currentHeaders.length); i++) {
        const expected = expectedHeaders[i] || '(missing)';
        const current = String(currentHeaders[i] || '').trim() || '(empty)';
        const match = expected === current ? '✓' : '✗';
        Logger.log(`Column ${i + 1}: ${match} Expected="${expected}" Current="${current}"`);
    }

    if (lastColumn === expectedHeaders.length) {
        let allMatch = true;
        for (let i = 0; i < expectedHeaders.length; i++) {
            if (String(currentHeaders[i] || '').trim() !== expectedHeaders[i]) {
                allMatch = false;
                break;
            }
        }
        if (allMatch) {
            Logger.log('\n✅ Schema is CORRECT!');
        } else {
            Logger.log('\n⚠️  Column count is correct but header names are wrong.');
            Logger.log('Run fixMoMHeaders() to fix just the header names.');
        }
    } else if (lastColumn < expectedHeaders.length) {
        Logger.log('\n❌ Missing columns! Run migrateMoMsToNewSchema() to add Attendees column.');
    } else {
        Logger.log('\n❌ Extra columns detected! Run migrateMoMsToNewSchema() to remove them.');
    }
}

// --- COMPLETE FIX: Fixes both headers AND data structure ---
function fixMoMCompleteWithData() {
    const ss = SpreadsheetApp.openById(SPREADSHEET_ID);
    const sheet = ss.getSheetByName('MoMs');

    if (!sheet) {
        Logger.log('❌ MoMs sheet does not exist.');
        return;
    }

    const lastColumn = sheet.getLastColumn();
    const currentHeaders = sheet.getRange(1, 1, 1, lastColumn).getValues()[0];

    Logger.log('Current structure:');
    Logger.log('Headers: ' + currentHeaders.join(' | '));
    Logger.log('Columns: ' + lastColumn);

    const col4Header = String(currentHeaders[3] || '').trim();
    const correctHeaders = ['ID', 'Date', 'Title', 'Attendees', 'Notes', 'ActionItemsJSON', 'CreatedBy'];

    // CASE 1: 7 columns with wrong structure (Notes in position 4)
    if (lastColumn === 7 && col4Header === 'Notes') {
        Logger.log('Detected: 7 columns with Notes in position 4 (wrong structure)');
        Logger.log('Action: Delete last column, then insert Attendees column...');

        // Delete the duplicate last column
        sheet.deleteColumn(7);
        Logger.log('Deleted column 7');

        // Now we have 6 columns: ID, Date, Title, Notes, ActionItemsJSON, CreatedBy
        // Insert Attendees after Title (position 3)
        sheet.insertColumnAfter(3);
        Logger.log('Inserted new column after position 3');

        // Fill existing rows with empty Attendees
        if (sheet.getLastRow() > 1) {
            sheet.getRange(2, 4, sheet.getLastRow() - 1, 1).setValue('');
            Logger.log('Filled ' + (sheet.getLastRow() - 1) + ' rows with empty Attendees values');
        }

        // Set correct headers
        sheet.getRange(1, 1, 1, 7).setValues([correctHeaders]);
        sheet.setFrozenRows(1);
        sheet.getRange(1, 1, 1, 7).setFontWeight("bold");

        Logger.log('✅ COMPLETE! Headers and data structure fixed.');
        Logger.log('New structure: ' + correctHeaders.join(' | '));
    }
    // CASE 2: 6 columns without Attendees
    else if (lastColumn === 6 && col4Header === 'Notes') {
        Logger.log('Detected: 6 columns without Attendees');
        Logger.log('Action: Insert Attendees column...');

        sheet.insertColumnAfter(3);

        if (sheet.getLastRow() > 1) {
            sheet.getRange(2, 4, sheet.getLastRow() - 1, 1).setValue('');
        }

        sheet.getRange(1, 1, 1, 7).setValues([correctHeaders]);
        sheet.setFrozenRows(1);
        sheet.getRange(1, 1, 1, 7).setFontWeight("bold");

        Logger.log('✅ COMPLETE! Attendees column added.');
        Logger.log('New structure: ' + correctHeaders.join(' | '));
    }
    // CASE 3: Already correct
    else if (lastColumn === 7 && col4Header === 'Attendees') {
        Logger.log('✅ Schema already correct!');
        Logger.log('Current structure: ' + currentHeaders.join(' | '));
    }
    // CASE 4: Unknown state
    else {
        Logger.log('❌ Unexpected schema state:');
        Logger.log('Columns: ' + lastColumn + ', Column 4: ' + col4Header);
        Logger.log('Run checkMoMSchema() for detailed diagnostic.');
    }
}

// --- NUCLEAR OPTION: Force Fix MoM Headers ONLY (Don't use if you have data!) ---
// Use this if migration keeps failing - this just fixes header names without touching data
function fixMoMHeaders() {
