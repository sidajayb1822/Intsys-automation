// --- Manual MoM Migration Helper ---
// Run this ONCE if you have existing MoM data with the old schema
function migrateMoMsToNewSchema() {
    const ss = SpreadsheetApp.openById(SPREADSHEET_ID);
    const sheet = ss.getSheetByName('MoMs');

    if (!sheet) {
        Logger.log('❌ MoMs sheet does not exist. Run setup() first.');
        return;
    }

    const lastColumn = sheet.getLastColumn();
    const currentHeaders = sheet.getRange(1, 1, 1, lastColumn).getValues()[0];

    Logger.log('Current headers: ' + currentHeaders.join(' | '));
    Logger.log('Current column count: ' + lastColumn);

    // Check if we have the old schema (6 columns without Attendees)
    if (lastColumn === 6 && String(currentHeaders[3]).trim() === 'Notes') {
        Logger.log('Old schema detected. Migrating...');

        // Insert a new column after "Title" (column 3)
        sheet.insertColumnAfter(3);

        // Set the correct headers
        const newHeaders = ['ID', 'Date', 'Title', 'Attendees', 'Notes', 'ActionItemsJSON', 'CreatedBy'];
        sheet.getRange(1, 1, 1, newHeaders.length).setValues([newHeaders]);

        // Fill the Attendees column with empty strings for existing rows
        if (sheet.getLastRow() > 1) {
            sheet.getRange(2, 4, sheet.getLastRow() - 1, 1).setValue('');
        }

        sheet.setFrozenRows(1);
        sheet.getRange(1, 1, 1, newHeaders.length).setFontWeight("bold");

        Logger.log('✅ Migration complete! New headers: ' + newHeaders.join(' | '));
    } else if (lastColumn === 7 && String(currentHeaders[3]).trim() === 'Attendees') {
        Logger.log('✅ Schema is already correct. No migration needed.');
    } else if (lastColumn > 7) {
        Logger.log('⚠️  Extra columns detected. Deleting columns beyond position 7...');
        sheet.deleteColumns(8, lastColumn - 7);

        // Set correct headers
        const newHeaders = ['ID', 'Date', 'Title', 'Attendees', 'Notes', 'ActionItemsJSON', 'CreatedBy'];
        sheet.getRange(1, 1, 1, newHeaders.length).setValues([newHeaders]);
        sheet.setFrozenRows(1);
        sheet.getRange(1, 1, 1, newHeaders.length).setFontWeight("bold");

        Logger.log('✅ Extra columns removed. Headers corrected.');
    } else {
        Logger.log('❌ Unrecognized schema. Current headers: ' + currentHeaders.join(' | '));
        Logger.log('Please manually delete the MoMs sheet and run setup() again.');
    }
}

// --- Data Setup Engine ---
function setup() {
    if (!SPREADSHEET_ID || SPREADSHEET_ID === "PASTE_YOUR_SHEET_ID_HERE") {
        throw new Error("You must paste your SPREADSHEET_ID at the top of the file before running setup().");
    }

    const ss = SpreadsheetApp.openById(SPREADSHEET_ID);
    checkAndFixHeaders(ss);

    if (ss.getSheetByName('Users').getLastRow() <= 1) {
        ss.getSheetByName('Users').appendRow(['Admin', 'admin@example.com', 'admin123', 'Admin', 0, 0]);
    }
    if (ss.getSheetByName('Companies').getLastRow() <= 1) {
        ss.getSheetByName('Companies').appendRow(['COMP-001', 'Acme Corp', 'NY', 'LinkedIn', 'Lead Generated', new Date(), 'admin@example.com', '[{"name":"Alice","role":"CTO","email":"a@acme.com","phone":"123"}]']);
        ss.getSheetByName('Interactions').appendRow([new Date(), 'COMP-001', 'Status Change', 'Marketing Lead created with status Lead Generated', 'admin@example.com', '', '', 'Completed', newInteractionId()]);
    }

    const defaultSheet = ss.getSheetByName("Sheet1");
    if (defaultSheet && ss.getSheets().length > 1) {
        ss.deleteSheet(defaultSheet);
    }
}

// --- Manual Diagnostic/Fix Functions ---
function backfillInteractionIDs() {
    const ss = SpreadsheetApp.openById(SPREADSHEET_ID);
    const sheet = ss.getSheetByName('Interactions');
    
    if (!sheet) {
        Logger.log("Interactions sheet not found.");
        return;
    }
    
    // Ensure the header exists
    sheet.getRange(1, 9).setValue('InteractionID');
    
    const lastRow = sheet.getLastRow();
    if (lastRow <= 1) {
        Logger.log("No data rows found to backfill.");
        return;
    }
    
    // Get existing IDs from column 9
    const existingIds = sheet.getRange(2, 9, lastRow - 1, 1).getValues();
    let updatedCount = 0;
    
    for (let i = 0; i < existingIds.length; i++) {
        // If the ID is empty, generate one
        if (!existingIds[i][0] || String(existingIds[i][0]).trim() === '') {
            existingIds[i][0] = 'INT-' + Utilities.getUuid().substring(0, 8).toUpperCase();
            updatedCount++;
        }
    }
    
    // Write back the array
    if (updatedCount > 0) {
        sheet.getRange(2, 9, lastRow - 1, 1).setValues(existingIds);
        Logger.log(`Successfully generated and inserted ${updatedCount} missing Interaction IDs!`);
    } else {
        Logger.log("All rows already have an Interaction ID. Nothing to update.");
    }
}